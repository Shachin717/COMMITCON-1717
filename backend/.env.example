# Application Environment: development, testing, production
APP_ENV=development
API_V1_PREFIX=/api/v1
PROJECT_NAME="Smart Classroom Allocation System"

# Database Configuration (PostgreSQL default, or sqlite:///./local.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classroom_allocation

# Security & Authentication
SECRET_KEY=supersecretkey-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:3000

# Optimization Engine Configuration
SOLVER_TIME_LIMIT_SECONDS=30.0
SOLVER_RANDOM_SEED=42
SOLVER_NUM_WORKERS=8

