POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_classroom
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/smart_classroom

APP_NAME="Smart Classroom Allocation System"
APP_ENV=development
APP_DEBUG=true
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# SMTP / Email Configuration
# ==========================================
# Option 1: Mailpit (Default for Local Development / Docker)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=no-reply@smartclassroom.edu
EMAILS_FROM_NAME="Smart Classroom System"

# Option 2: Gmail App Password (Production / Staging)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_TLS=true
# MAIL_FROM=your-address@gmail.com
# EMAILS_FROM_NAME="Smart Classroom System"
